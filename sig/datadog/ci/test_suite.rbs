module Datadog
  module CI
    class TestSuite < ConcurrentSpan
      type test_id = String | [String, String, String]

      @execution_stats_per_test: Hash[test_id, Hash[String, Integer]]
      @final_statuses_per_test: Hash[test_id, String]
      @expected_tests_set: Set[String]
      @custom_impacted_files: Array[String]
      @tests_skipped_by_tia_count: Integer

      def tests_skipped_by_tia_count: () -> Integer

      def incr_tests_skipped_by_tia_count: () -> void

      def add_impacted_files: (Array[String] file_paths) -> void

      def record_test_result: (test_id test_id, String datadog_test_status) -> void

      def lock_custom_impacted_files: () -> Array[String]

      def record_test_final_status: (test_id test_id, String final_status) -> void

      def any_passed?: () -> bool

      def test_executed?: (test_id test_id) -> bool

      def any_test_retry_passed?: (test_id) -> bool

      def all_executions_failed?: (test_id) -> bool

      def all_executions_passed?: (test_id) -> bool

      def set_expected_tests!: (Enumerable[String] tests) -> void

      def expected_test_done!: (String test_name) -> void

      def datadog_skip_reason: () -> String?

      def should_skip?: () -> bool

      def skipped_by_test_impact_analysis?: () -> bool

      def itr_unskippable?: () -> bool

      private

      def ensure_custom_impacted_files_mutable!: () -> void

      def set_status_from_stats!: () -> void
    end
  end
end
