module Datadog
  module CI
    class Worker
      @operation: ^(*untyped) -> untyped
      @pid: Integer
      @mutex: Mutex
      @thread: Thread?
      DEFAULT_SHUTDOWN_TIMEOUT: 60
      def initialize: () { (*untyped) -> untyped } -> void
      def perform: (*untyped) -> Thread?
      def stop: (?Numeric) -> Thread?
      def wait_until_done: (?Numeric?) -> Thread?
      def started?: () -> bool
      def running?: () -> bool
      def done?: () -> bool
    end
    class DummyWorker < Worker
      def initialize: () -> void
    end
  end
end
