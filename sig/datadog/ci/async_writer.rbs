module Datadog
  module CI
    interface _AsyncEventTransport[in Event]
      def send_events: (Array[Event] events) -> void
    end

    class AsyncWriter[Event]
      class EventTransport[Event]
        @transport: _AsyncEventTransport[Event]
        def initialize: (_AsyncEventTransport[Event] transport) -> void
        def send_traces: (Array[Event] events) -> void
      end

      @transport: _AsyncEventTransport[Event]
      @writer: EventWriter[Event]
      attr_reader transport: _AsyncEventTransport[Event]

      DEFAULT_BUFFER_MAX_SIZE: 10000
      DEFAULT_SHUTDOWN_TIMEOUT: 60
      DEFAULT_INTERVAL: Float

      def initialize: (transport: _AsyncEventTransport[Event], ?options: { ?buffer_size: Integer, ?interval: Float, ?shutdown_timeout: Numeric }) -> void
      def write: (Event event) -> bool
      def perform: (*Event events) -> nil
      def stop: (?bool force_stop, ?Numeric timeout) -> void
      def flush: () -> void
      def started?: () -> bool
      def running?: () -> bool
      def async?: () -> true
    end
  end
end
