module Datadog
  module CI
    class EventTracer
      @service: String?
      @tags: Hash[String | Symbol, Object?]
      @context_key: Symbol
      @runtime_id: String
      @pid: Integer

      attr_reader writer: _EventWriter

      def initialize: (writer: _EventWriter, ?service: String?, ?tags: Hash[String | Symbol, Object?]) -> void
      def trace: [R] ((String | Symbol) name, ?service: String?, ?type: String?, ?resource: String?, ?new_trace: bool, ?tags: Hash[String | Symbol, Object?]) { (EventSpan, EventTrace?) -> R } -> R
               | ((String | Symbol) name, ?service: String?, ?type: String?, ?resource: String?, ?new_trace: bool, ?tags: Hash[String | Symbol, Object?]) -> EventSpan
      def active_span: () -> EventSpan?
      def active_trace: () -> EventTrace?
      def shutdown!: () -> void

      private
      def stack: () -> Array[EventSpan]
      def runtime_id: () -> String
      def finish_span: (EventSpan span, Array[EventSpan] context) -> void
    end
  end
end
