        @test_impact_analysis: Datadog::CI::TestImpactAnalysis::Component | Datadog::CI::TestImpactAnalysis::NullComponent
        @git_tree_upload_worker: Datadog::CI::Worker
        @ci_remote: Datadog::CI::Remote::Component | Datadog::CI::Remote::NullComponent
        @test_retries: Datadog::CI::TestRetries::Component | Datadog::CI::TestRetries::NullComponent
        @custom_configuration: Hash[String, String]
        @test_management: Datadog::CI::TestManagement::Component | Datadog::CI::TestManagement::NullComponent
