module Datadog
  module CI
    module Configuration
      class Components
        @shutdown: bool?
        @tracer: Datadog::CI::EventTracer
        @tracer_bridge: Datadog::CI::TracerBridge::Component | Datadog::CI::TracerBridge::NullComponent
        @telemetry: Datadog::CI::Telemetry::Component | Datadog::CI::Telemetry::NullComponent
        attr_reader tracer: Datadog::CI::EventTracer
        attr_reader tracer_bridge: Datadog::CI::TracerBridge::Component | Datadog::CI::TracerBridge::NullComponent
        attr_reader telemetry: Datadog::CI::Telemetry::Component | Datadog::CI::Telemetry::NullComponent
