module Datadog
  module CI
    interface _EventTransport[in Event]
      def send_traces: (Array[Event] traces) -> void
    end

    interface _EventLogger
      def warn: (String message) -> void
    end

    interface _EventWriter
      def write: (_EventTrace trace) -> bool
      def flush: () -> void
      def shutdown!: () -> void
    end

    class EventWriter[Event]
      @transport: _EventTransport[Event]
      @logger: _EventLogger
      @buffer_size: Integer
      @flush_interval: Float
      @shutdown_timeout: Numeric
      @pid: Integer
      @mutex: Mutex
      @send_mutex: Mutex
      @condition: ConditionVariable
      @buffer: Array[Event]
      @worker: Thread?
      @stopped: bool

      attr_reader transport: _EventTransport[Event]

      def initialize: (transport: _EventTransport[Event], logger: _EventLogger, ?buffer_size: Integer, ?flush_interval: Float, ?shutdown_timeout: Numeric) -> void
      def write: (Event trace) -> bool
      def flush: () -> void
      def shutdown!: () -> void
      alias stop shutdown!
      def running?: () -> bool
      def started?: () -> bool
      def stopped?: () -> bool

      private
      def warn_safely: (String message) -> void
      def reset_process_state: () -> void
      def start_worker: () -> void
    end
  end
end
