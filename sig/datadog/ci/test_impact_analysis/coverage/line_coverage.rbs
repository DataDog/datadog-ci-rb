module Datadog
  module CI
    module TestImpactAnalysis
      module Coverage
        class LineCoverage
          class Context
            attr_reader serial: Integer

            attr_reader fiber: Fiber

            attr_reader previous: Integer?

            def initialize: (Integer serial, Fiber fiber, Integer? previous) -> void
          end

          EMPTY_COVERAGE: LineCollector::packed_bitmaps

          EMPTY_SHARED: Hash[String, LineCollector::bitmaps]

          @root: String
          @ignored_paths: Array[String]
          @mutex: Thread::Mutex
          @tests: Hash[Integer, Context]
          @test_ids_by_serial: Hash[Integer, Integer]
          @fixtures: Hash[String, Context]
          @fixture_serials: Hash[Integer, bool]
          @open_fixture_id: String?

          self.@running_with: [String, Array[String]]?

          self.@first_root: String?

          def self.supported?: () -> bool

          def self.ignored_paths: (String? bundle_location) -> Array[String]

          def self.start: (root: String, ignored_paths: Array[String]) -> LineCoverage?

          def self.stop_collector: () -> void

          def initialize: (root: String, ignored_paths: Array[String]) -> void

          def collect_child_processes: () -> nil

          def start_test: (Integer test_id) -> void

          def finish_test: (Integer test_id, Array[String] fixture_ids) -> LineCollector::packed_bitmaps

          def discard_test: (Integer test_id) -> void

          def start_fixture: (String fixture_id) -> void

          def release_fixture: (String fixture_id) -> void

          def shared: () -> Hash[String, LineCollector::bitmaps]

          def stop: () -> void

          private

          def add_child_records: (LineCollector::packed_bitmaps coverage, Integer serial, Array[Integer] fixture_serials) -> LineCollector::packed_bitmaps

          def add_remaining_child_records: (Hash[String, LineCollector::bitmaps] shared) -> Hash[String, LineCollector::bitmaps]

          def close_open_fixture: () -> void

          def release_fixture_context: (Context? fixture) -> void

          def remove_test: (Integer test_id) -> Context?

          def release_unfinished_test: (Integer? current) -> Integer?

          def restore_fiber_context: (Context context) -> void

          def log_error: (String action, Exception error) -> void
        end
      end
    end
  end
end
