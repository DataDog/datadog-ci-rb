module Datadog
  module CI
    module TestImpactAnalysis
      module Coverage
        class Session
          HELPER_PATHS: Array[String]
          LOAD_METHODS: Array[Symbol]

          @root: String
          @root_prefix: String
          @ignored_path: String?
          @files: Hash[String, bool]
          @loading: Hash[Thread, Integer]
          @failed: bool
          @tracepoint: TracePoint?

          def initialize: (root: String, ignored_path: String?) -> void
          def start: () -> void
          def stop: () -> Hash[String, bool]
          def record_file_read: (String path) -> void

          private

          def observe: (TracePoint event) -> void
          def record: (String path) -> void
        end
      end
    end
  end
end
