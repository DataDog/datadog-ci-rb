module Datadog
  module CI
    module TestImpactAnalysis
      module Coverage
        # Implemented in ext/datadog_ci_native/line_coverage.c. Only supported? and
        # yjit_supported? exist when the extension was built without line coverage.
        module LineCollector
          type bitmaps = Hash[String, String]

          # The number of files, and a msgpack map {"filename", "bitmap"} for each.
          type packed_bitmaps = [Integer, String]

          CONTEXT_KEY: Symbol

          # How long exit! may spend writing the records registered with write_record_at_exit.
          EXIT_WRITE_DEADLINE_SECONDS: Integer

          def self.supported?: () -> bool

          def self.yjit_supported?: () -> bool

          def self.start: (String root, Array[String] ignored_paths) -> bool

          def self.stop: () -> bool

          def self.open_context: (?bool fixture) -> Integer?

          def self.close_context: (Integer serial) -> bool

          def self.coverage: (Integer serial, Array[Integer] fixture_serials) -> packed_bitmaps

          def self.release: (Integer serial) -> bool

          def self.shared: () -> Hash[String, bitmaps]

          # Also replaces Kernel#exit!, Kernel.exit! and Process.exit! with an exit! that writes
          # the records first, then ends the process as Ruby's own does, or calls the exit! that
          # code had patched before.
          def self.write_record_at_exit: (String prefix, Integer serial, bool shared_since_now) -> bool

          def self.stats: () -> Hash[Symbol, untyped]
        end
      end
    end
  end
end
