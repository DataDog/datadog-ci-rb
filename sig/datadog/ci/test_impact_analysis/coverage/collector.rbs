module Datadog
  module CI
    module TestImpactAnalysis
      module Coverage
        class Collector
          @ruby: DDCov
          @files: FileAccess

          def initialize: (root: String, ignored_path: String?, threading_mode: DDCov::threading_mode, use_allocation_tracing: bool) -> void
          def start: () -> void
          def stop: () -> Hash[String, untyped]
        end
      end
    end
  end
end
