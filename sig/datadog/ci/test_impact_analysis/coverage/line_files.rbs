module Datadog
  module CI
    module TestImpactAnalysis
      module Coverage
        class LineFiles
          FILENAME: String

          BITMAP: String

          @bitmap_count: Integer
          @packed_bitmaps: String
          @custom_impacted_files: Array[String]

          def self.from_bitmaps: (LineCollector::bitmaps bitmaps, ?Array[String] custom_impacted_files) -> LineFiles

          def self.pack: (LineCollector::bitmaps bitmaps) -> LineCollector::packed_bitmaps

          def self.unpack: (String packed_bitmaps) -> LineCollector::bitmaps

          def self.add_bitmaps: (LineCollector::bitmaps bitmaps, LineCollector::bitmaps more) -> LineCollector::bitmaps

          def self.union: (String? left, String right) -> String

          def initialize: (Integer bitmap_count, String packed_bitmaps, ?Array[String] custom_impacted_files) -> void

          def each: () { (String file) -> void } -> void

          def size: () -> Integer

          def write_to: (untyped packer) -> untyped

          def inspect_coverage: () -> Hash[String, Array[Integer] | true]

          def self.lines: (String bitmap) -> Array[Integer]

          private

          def bitmaps: () -> LineCollector::bitmaps
        end
      end
    end
  end
end
