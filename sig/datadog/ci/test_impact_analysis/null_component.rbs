module Datadog
  module CI
    module TestImpactAnalysis
      class NullComponent
        FILE_STORAGE_KEY: String

        attr_reader enabled: bool
        attr_reader test_skipping_enabled: bool
        attr_reader code_coverage_enabled: bool
        attr_reader skippable_tests: Set[String]
        attr_reader skippable_suites: Set[String]
        attr_reader correlation_id: String?
        attr_reader test_skipping_mode: String

        def initialize: () -> void

        def configure: (?Datadog::CI::Remote::LibrarySettings remote_configuration, ?Datadog::CI::TestSession test_session) -> void

        def enabled?: () -> bool

        def skipping_tests?: () -> bool

        def skipping_suites?: () -> bool

        def test_skipping_mode?: () -> bool

        def suite_skipping_mode?: () -> bool

        def code_coverage?: () -> bool

        def start_coverage: () -> void

        def stop_coverage: () -> Hash[String, untyped]?

        def on_test_context_started: (String context_id) -> void

        def on_test_started: (Datadog::CI::Test test) -> void

        def on_test_finished: (Datadog::CI::Test test, Datadog::CI::TestTracing::Context context) -> Datadog::CI::TestImpactAnalysis::Coverage::Event?

        def on_test_suite_started: (Datadog::CI::TestSuite test_suite) -> void

        def on_test_suite_finished: (Datadog::CI::TestSuite test_suite, Datadog::CI::TestTracing::Context context) -> Datadog::CI::TestImpactAnalysis::Coverage::Event?

        def clear_context_coverage: (String context_id) -> void

        def context_coverage_enabled?: () -> bool

        def mark_if_skippable: (Datadog::CI::Test test) -> void

        def skippable?: (String datadog_test_id) -> bool

        def skippable_suite?: (String test_suite_name) -> bool

        def mark_if_suite_skippable: (Datadog::CI::TestSuite test_suite) -> void

        def write_test_session_tags: (Datadog::CI::TestSession test_session, Integer skipped_tests_count) -> void

        def shutdown!: () -> void

        def serialize_state: () -> Hash[Symbol, untyped]

        def restore_state: (Hash[Symbol, untyped] state) -> void

        def storage_key: () -> String

        def restore_state_from_datadog_test_runner: () -> bool
      end
    end
  end
end
