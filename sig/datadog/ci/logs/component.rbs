module Datadog
  module CI
    module Logs
      class Component
        attr_reader enabled: bool

        @writer: Datadog::CI::AsyncWriter[Hash[Symbol | String, untyped]]?

        def self.build: (enabled: bool, api: Datadog::CI::Transport::Api::Base?, discard_traces: bool) -> Component

        def initialize: (enabled: bool, writer: Datadog::CI::AsyncWriter[Hash[Symbol | String, untyped]]?) -> void

        def write: (Hash[Symbol | String, untyped] event) -> void

        def shutdown!: () -> void

        private

        def add_common_tags!: (Hash[Symbol | String, untyped] event) -> void

        def test_tracing: () -> (Datadog::CI::TestTracing::Component | Datadog::CI::TestTracing::NullComponent)
      end
    end
  end
end
