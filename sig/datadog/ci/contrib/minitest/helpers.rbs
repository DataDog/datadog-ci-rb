module Datadog
  module CI
    module Contrib
      module Minitest
        module Helpers
          module RunnableClassMethods : Class
            @datadog_prevent_failure_suppression_tests: Hash[String, UnboundMethod]?
            @datadog_no_auto_retry_tests: Hash[String, UnboundMethod]?
            @datadog_itr_unskippable_suite: bool
            @datadog_itr_unskippable_tests: Array[String]?

            def datadog_prevent_failure_suppression: (*(String | Symbol) test_names) -> void
            def datadog_no_auto_retry: (*(String | Symbol) test_names) -> void
            def dd_test_prevent_failure_suppression?: ((String | Symbol) test_name, ?UnboundMethod declaration) -> bool
            def dd_test_no_auto_retry?: ((String | Symbol) test_name, ?UnboundMethod declaration) -> bool
            def dd_automation_exclusion_declaration: ((String | Symbol) test_name) -> UnboundMethod
            def dd_clear_automation_exclusions: (String | Symbol test_name) -> void

            def datadog_itr_unskippable: (*untyped) -> void

            def dd_suite_unskippable?: () -> bool

            def dd_test_unskippable?: (String test_name) -> bool

            def dd_any_unskippable?: () -> bool
          end

          interface _RunnableClass
            def dd_clear_automation_exclusions: ((String | Symbol) test_name) -> void
            def runnable_methods: () -> Array[String]

            def name: () -> String?

            def instance_method: ((String | Symbol) method_name) -> UnboundMethod

            def ancestors: () -> Array[Module]

            def dd_any_unskippable?: () -> bool

            def nil?: () -> bool
          end

          def self.start_test_suite: (_RunnableClass klass) -> Datadog::CI::TestSuite?

          def self.skip_test_suite: (Datadog::CI::TestSuite test_suite) -> Array[untyped]

          def self.test_suite_name: (_RunnableClass klass, String method_name) -> ::String

          def self.parallel?: (_RunnableClass klass) -> bool

          def self.ci_queue?: () -> bool

          def self.extract_source_location_from_class: (untyped? klass) -> ([String, Integer] | Array[untyped])?

          def self.extract_source_location_from_method: (untyped? klass, String? method_name) -> ([String, Integer] | Array[untyped])?

          def self.empty_source_location_to_nil: (([String, Integer] | Array[untyped])? source_location) -> ([String, Integer] | Array[untyped])?

          def self.extract_runnable_source_location: (untyped? klass, String method_name) -> ([String, Integer] | Array[untyped])?
        end
      end
    end
  end
end
