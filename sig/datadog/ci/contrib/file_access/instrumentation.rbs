module Datadog
  module CI
    module Contrib
      module FileAccess
        module Instrumentation
          def self.test_impact_analysis: () -> (Datadog::CI::TestImpactAnalysis::Component | Datadog::CI::TestImpactAnalysis::NullComponent)?

          def self.with_pathname_read: () { () -> String } -> String

          module PathnameMethods : ::Pathname
            def to_path: () -> String
          end

          module InstanceMethods : ::File
            # File construction accepts both paths and descriptors, with
            # platform/version-specific IO options passed through ruby2_keywords.
            def initialize: (*untyped) -> void
          end

          module ClassMethods : Class
            def read: (String | _ToPath | _ToStr path, *untyped) ?{ (*untyped) -> untyped } -> String
            def binread: (String | _ToPath | _ToStr path, *untyped) ?{ (*untyped) -> untyped } -> String
          end
        end
      end
    end
  end
end
