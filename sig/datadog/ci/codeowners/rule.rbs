module Datadog
  module CI
    module Codeowners
      class Rule
        GLOB_CHARS: Regexp

        @pattern: String
        @owners: Array[String]
        @flags: Integer
        @match_all: bool
        @directory_prefix: String?
        @literal_prefix: String?
        @directory_pattern: String?

        attr_reader pattern: String

        attr_reader owners: Array[String]

        def initialize: (String pattern, Array[String] owners) -> void

        def match?: (String file_path) -> bool

        private

        def compute_flags: (String pattern) -> Integer
      end
    end
  end
end
