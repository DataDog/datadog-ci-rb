module Datadog
  module CI
    module Utils
      module Telemetry
        def self.inc: (String metric_name, Integer count, ?Datadog::CI::Telemetry::metric_tags tags) -> void

        def self.distribution: (String metric_name, Float value, ?Datadog::CI::Telemetry::metric_tags tags) -> void

        def self.itr_forced_run: () -> void

        def self.itr_unskippable: () -> void

        def self.record_dynamic_atr_retries: (has_custom_buckets: bool) -> void

        def self.telemetry: () -> (Datadog::CI::Telemetry::Component | Datadog::CI::Telemetry::NullComponent)

        private

        def self.itr_test_tags: () -> ::Hash[String, String]
      end
    end
  end
end
