module Capybara
end

module Capybara::Cuprite
end

module Ferrum
end

class Ferrum::Browser
  def version: () -> Ferrum::Browser::VersionInfo

  def options: () -> Ferrum::Browser::Options

  def evaluate: (String script) -> Object

  def current_url: () -> String

  def cookies: () -> Ferrum::Cookies
end

class Ferrum::Cookies
  def set: (Hash[Symbol, String?] options) -> bool

  def remove: (name: String, ?domain: String?) -> bool
end

class Ferrum::Browser::Options
  def to_h: () -> Hash[Symbol, Object]
end

class Ferrum::Browser::VersionInfo
  def product: () -> String
end

module Capybara::Cuprite::Driver
  @browser: Ferrum::Browser?

  def visit: (String url) -> untyped

  def reset!: () -> void

  def quit: () -> void

  def execute_script: (String script, ?untyped args) -> untyped

  def browser: () -> Ferrum::Browser
end
